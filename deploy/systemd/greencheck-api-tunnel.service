[Unit]
Description=Green Check scraper API SSH tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rrodichev
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -i /home/rrodichev/.ssh/greencheck_deploy -L 127.0.0.1:18000:127.0.0.1:8000 root@174.138.54.153
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
